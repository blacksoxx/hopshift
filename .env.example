# Copy to .env and fill in. Never commit .env.

# ─── Platform ────────────────────────────────────────────────────────────────
# Encrypts stored cloud credentials and MFA secrets at rest. Required by docker compose.
# Generate: python -m hopshift.cli.main secrets generate-key   (or: hopshift secrets generate-key)
HOPSHIFT_SECRET_KEY=

# Host port for the UI/API when using docker compose (container always listens on 8080).
HOPSHIFT_PORT=8080

# OIDC single sign-on client secret (only when security.auth.oidc.enabled is true).
HOPSHIFT_OIDC_CLIENT_SECRET=

# ─── Model providers (optional) ──────────────────────────────────────────────
# Only needed for AI review notes and the llm/hybrid generation modes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional OpenAI-compatible endpoint override (Azure OpenAI, self-hosted proxy).
OPENAI_BASE_URL=
LLM_BASE_URL=

# LLM provider selection (anthropic | openai | google); config.yaml and CLI flags override these.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# MCP (Terraform docs) client tuning.
HOPSHIFT_MCP_TOOL_TIMEOUT_SECONDS=30
