# Copy to .env and fill in. Never commit .env.

# ─── Platform ────────────────────────────────────────────────────────────────
# HOPSHIFT_SECRET_KEY (required by docker compose) encrypts stored cloud credentials and MFA
# secrets at rest. It is a Fernet key; append one to .env with:
#   python3 -c "import base64,os;print('HOPSHIFT_SECRET_KEY='+base64.urlsafe_b64encode(os.urandom(32)).decode())" >> .env
# (or `hopshift secrets generate-key` when the package is installed). Keep it: losing it makes
# stored secrets unreadable.

# Host port for the UI/API when using docker compose (container always listens on 8080).
HOPSHIFT_PORT=8080

# OIDC single sign-on client secret (only when security.auth.oidc.enabled is true).
HOPSHIFT_OIDC_CLIENT_SECRET=

# ─── Model providers (optional) ──────────────────────────────────────────────
# Only needed for AI review notes and the llm/hybrid generation modes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional OpenAI-compatible endpoint override (Azure OpenAI, self-hosted proxy).
OPENAI_BASE_URL=
LLM_BASE_URL=

# LLM provider selection (anthropic | openai | google); config.yaml and CLI flags override these.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# MCP (Terraform docs) client tuning.
HOPSHIFT_MCP_TOOL_TIMEOUT_SECONDS=30
